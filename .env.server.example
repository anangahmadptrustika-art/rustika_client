# ──────────────────────────────────────────────────────────────
# RUSTIKA CLIENT — env untuk server sendiri (self-hosted, database ikut lokal)
# File .env DIBUAT OTOMATIS oleh scripts/install.sh — contoh ini hanya referensi.
# JANGAN commit .env. Simpan cadangan .env di tempat aman (tanpa file ini,
# database tidak bisa diakses karena password & JWT secret ada di sini).
# ──────────────────────────────────────────────────────────────

# ── Aplikasi ──
APP_DOMAIN=client.rustika.co.id
NEXT_PUBLIC_SITE_URL=https://client.rustika.co.id

# ── Database & auth lokal (dibuat otomatis; JANGAN diubah setelah database ada) ──
POSTGRES_PASSWORD=                      # openssl rand -hex 24
JWT_SECRET=                             # openssl rand -hex 32
# URL API database = site URL + /supabase-api (dirutekan Caddy ke auth/rest)
NEXT_PUBLIC_SUPABASE_URL=https://client.rustika.co.id/supabase-api
NEXT_PUBLIC_SUPABASE_ANON_KEY=          # JWT {role:anon} ditandatangani JWT_SECRET (installer)
SUPABASE_SERVICE_ROLE_KEY=              # JWT {role:service_role} — SERVER ONLY

# ── Penyimpanan file dokumen & foto (Cloudinary → Dashboard → Product Environment) ──
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── AI Assistant (opsional) → console.anthropic.com ──
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── Sync Google Sheet: nilai yang sama dipasang di Apps Script (docs/google-sheet-sync.gs) ──
SYNC_SECRET=                            # openssl rand -hex 32

# ── Jaringan ──
CLOUDFLARE_TUNNEL_TOKEN=                # mode Tunnel (default)
CADDY_SITE_ADDRESS=:80                  # mode Caddy: client.rustika.co.id (HTTPS otomatis)
CADDY_HTTP_BIND=127.0.0.1:8080          # mode Caddy: 0.0.0.0:80
CADDY_HTTPS_BIND=127.0.0.1:8443         # mode Caddy: 0.0.0.0:443

# ── Email (opsional; hanya untuk reset password / undangan lewat email) ──
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_ADMIN_EMAIL=
# SMTP_SENDER_NAME=Rustika Client

# ── Legacy S3/R2 (hanya jika masih ada file lama di R2; biasanya kosong) ──
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# S3_ENDPOINT=
# S3_REGION=
