# ──────────────────────────────────────────────────────────────
# RUSTIKA CLIENT — env untuk server sendiri (self-hosted)
# Salin: cp .env.server.example .env   lalu isi semua nilai. JANGAN commit .env.
# (Project Vercel sudah terhapus, jadi nilai-nilai ini harus diambil ulang.)
# ──────────────────────────────────────────────────────────────

# Domain aplikasi (tanpa https://) — subdomain "client". Ganti "domainmu" dengan domain aslimu,
# mis. client.rustika.co.id. Dipakai Caddy & untuk link/QR portal.
APP_DOMAIN=client.domainmu
NEXT_PUBLIC_SITE_URL=https://client.domainmu

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...anon...
SUPABASE_SERVICE_ROLE_KEY=eyJ...service_role...   # SERVER ONLY, jangan ke browser

# Cloudinary → Dashboard → Product Environment (penyimpanan dokumen & foto)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AI Assistant (opsional) → console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Sync Google Sheet → buat nilai BARU:  openssl rand -hex 32
# Nilai yang sama harus dipasang di Apps Script (docs/google-sheet-sync.gs).
SYNC_SECRET=

# Opsi A — Cloudflare Tunnel (hanya jika pakai `--profile tunnel`)
CLOUDFLARE_TUNNEL_TOKEN=

# Legacy S3/R2 (hanya jika masih ada file lama di R2/B2; biasanya kosong)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# S3_ENDPOINT=
# S3_REGION=
