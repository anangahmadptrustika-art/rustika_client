# ──────────────────────────────────────────────────────────────
# CLIENT RUSTIKA CONSULTANT — Environment Variables
# Copy this file to `.env.local` and fill in the values.
# ──────────────────────────────────────────────────────────────

# Supabase project URL (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co

# Supabase anon/public key (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Supabase service role key (SERVER ONLY — never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site URL — used for auth redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── File storage (Cloudinary) ────────────────────────────────
# Uploaded files (documents & photos) live in Cloudinary (25 GB free, no
# credit card) so they don't fill up Supabase Storage. The browser uploads
# straight to Cloudinary with a server-generated signature — no CORS setup
# needed. Find these on the Cloudinary Dashboard → Product Environment.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
#
# Legacy S3-compatible storage (Backblaze B2 / Cloudflare R2) — only needed to
# keep reading files uploaded before the Cloudinary switch:
# R2_ACCESS_KEY_ID=your-access-key-id
# R2_SECRET_ACCESS_KEY=your-secret-access-key
# R2_BUCKET=rustika-files
# S3_ENDPOINT=https://s3.us-east-005.backblazeb2.com

# ── AI Assistant (optional) ──────────────────────────────────
# The AI assistant uses the Anthropic Claude API.
# Get a key from https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key
# Model id — defaults to claude-sonnet-4-6 if unset
ANTHROPIC_MODEL=claude-sonnet-4-6
