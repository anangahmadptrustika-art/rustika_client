# ──────────────────────────────────────────────────────────────
# CLIENT RUSTIKA CONSULTANT — Environment Variables
# Copy this file to `.env.local` and fill in the values.
# ──────────────────────────────────────────────────────────────

# Supabase project URL (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co

# Supabase anon/public key (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Supabase service role key (SERVER ONLY — never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site URL — used for auth redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── File storage (S3-compatible) ─────────────────────────────
# Uploaded files (documents & photos) live in S3-compatible object storage
# so they don't fill up Supabase Storage. Works with Backblaze B2 (10 GB free,
# NO credit card for private buckets) or Cloudflare R2.
#
# Backblaze B2 (recommended — no credit card):
#   Application Key → keyID / applicationKey, and the bucket's "S3 Endpoint".
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-access-key
R2_BUCKET=rustika-files
# Backblaze B2: full endpoint shown on the bucket page, e.g.
S3_ENDPOINT=https://s3.us-west-004.backblazeb2.com
# Optional — auto-derived from a Backblaze endpoint; "auto" for R2.
# S3_REGION=us-west-004
#
# Cloudflare R2 alternative — set this instead of S3_ENDPOINT:
# R2_ACCOUNT_ID=your-cloudflare-account-id

# ── AI Assistant (optional) ──────────────────────────────────
# The AI assistant uses the Anthropic Claude API.
# Get a key from https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key
# Model id — defaults to claude-sonnet-4-6 if unset
ANTHROPIC_MODEL=claude-sonnet-4-6
